rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function shortText(value, limit) { return value is string && value.size() <= limit; }
    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['lastChecklist']) && shortText(request.resource.data.lastChecklist, 100);
      match /checklists/{slug} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['cycle']) && shortText(request.resource.data.cycle, 100);
        match /items/{id} {
          allow read, delete: if owns(uid);
          allow create, update: if owns(uid)
            && request.resource.data.keys().hasOnly(['label', 'note', 'kind', 'order', 'hidden', 'custom', 'sectionId', 'relatedChecklistSlug'])
            && (!('label' in request.resource.data) || (shortText(request.resource.data.label, 500) && request.resource.data.label.size() > 0))
            && (!('note' in request.resource.data) || shortText(request.resource.data.note, 2000))
            && (!('sectionId' in request.resource.data) || shortText(request.resource.data.sectionId, 150))
            && (!('relatedChecklistSlug' in request.resource.data) || shortText(request.resource.data.relatedChecklistSlug, 100))
            && (!('kind' in request.resource.data) || request.resource.data.kind in ['core', 'optional'])
            && (!('order' in request.resource.data) || request.resource.data.order is number)
            && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
            && (!('custom' in request.resource.data) || request.resource.data.custom is bool);
        }
        match /sections/{id} {
          allow read, delete: if owns(uid);
          allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['title', 'order', 'custom'])
            && (!('title' in request.resource.data) || (shortText(request.resource.data.title, 500) && request.resource.data.title.size() > 0))
            && (!('order' in request.resource.data) || request.resource.data.order is number)
            && (!('custom' in request.resource.data) || request.resource.data.custom is bool);
        }
        match /cycles/{cycle}/states/{id} {
          allow read: if owns(uid);
          // Old-cycle offline writes may settle, but the UI only reads the current cycle.
          allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['status']) && request.resource.data.status in ['unpacked', 'packed', 'skipped'];
        }
      }
    }
  }
}
