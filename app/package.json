{
  "name": "packbee",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "node scripts/build-web.mjs --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src App.tsx index.ts && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build-web.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "android:apk": "npx --yes eas-cli build --platform android --profile preview",
    "ios:build": "npx --yes eas-cli build --platform ios --profile production",
    "test:rules": "firebase emulators:exec --project demo-packbee --only firestore \"tsx --test tests/rules.integration.ts\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.18.0",
    "lucide-react-native": "^1.41.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.29.0",
    "globals": "^16.5.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
